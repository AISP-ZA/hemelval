{
  "expo": {
    "name": "Decanta",
    "slug": "decanta",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "decanta",
    "icon": "./assets/ios-icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#241b18",
      "resizeMode": "contain"
    },
    "android": {
      "package": "za.co.decanta.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/ios-icon.png",
        "backgroundColor": "#08030a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "za.co.decanta.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Decanta uses the camera to scan wine bottle labels and barcodes so you can log what you taste.",
        "NSLocationWhenInUseUsageDescription": "Decanta uses your location to show wineries near you in the Western Cape."
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "pwaDisplay": "standalone",
      "name": "Decanta — SA Wine"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermissionText": "Decanta uses the camera to scan wine bottle labels and barcodes."
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Decanta uses your location to show wineries near you in the Western Cape."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": ""
      },
      "router": {
        "origin": false
      }
    },
    "owner": "aisp-za"
  }
}
