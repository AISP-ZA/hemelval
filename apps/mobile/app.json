{
  "expo": {
    "name": "Decanta",
    "slug": "decanta",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "decanta",
    "splash": {
      "backgroundColor": "#241b18",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "za.co.decanta.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Decanta uses the camera to scan wine bottle labels and barcodes so you can log what you taste."
      }
    },
    "android": {
      "package": "za.co.decanta.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "pwaDisplay": "standalone",
      "name": "Decanta — SA Wine"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermissionText": "Decanta uses the camera to scan wine bottle labels and barcodes."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": ""
      },
      "router": {
        "origin": false
      }
    },
    "owner": "aisp-za"
  }
}
