{
  "expo": {
    "name": "Kelder",
    "slug": "kelder",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "kelder",
    "splash": {
      "backgroundColor": "#0a0a0a",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "za.co.kelder.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Kelder uses the camera to scan wine bottle labels and barcodes so you can log what you taste."
      }
    },
    "android": {
      "package": "za.co.kelder.app",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        { "cameraPermissionText": "Kelder uses the camera to scan wine bottle labels and barcodes." }
      ]
    ],
    "extra": {
      "eas": { "projectId": "" },
      "router": { "origin": false }
    },
    "owner": "aisp-za"
  }
}
